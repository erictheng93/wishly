{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "WishSync main window: no fs/shell/http",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://*" },
        { "url": "mailto:*" },
        { "url": "sms:*" },
        { "url": "line://*" }
      ]
    },
    "clipboard-manager:allow-write-text"
  ]
}

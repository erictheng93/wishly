{
  "name": "wishly-web",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/patch-dependencies.mjs && nuxt prepare",
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "npm run build && wrangler pages dev dist",
    "build:demo": "NUXT_DEMO=1 NUXT_PUBLIC_API_BASE= nuxt build",
    "deploy": "node scripts/check-prod-env.mjs && NUXT_DEMO= nuxt build && wrangler pages deploy dist --project-name wishly-web",
    "deploy:preview": "node scripts/check-preview-env.mjs && NUXT_DEMO= NUXT_PUBLIC_API_BASE= nuxt build && wrangler pages deploy dist --project-name wishly-web --branch qa",
    "deploy:demo": "npm run build:demo && wrangler pages deploy dist --project-name wishly-web",
    "build:native": "NUXT_NATIVE=1 NUXT_PUBLIC_SITE_URL=${NUXT_PUBLIC_SITE_URL:-https://wishly.tw} nuxt generate",
    "tauri": "tauri",
    "tauri:dev": "tauri dev --config src-tauri/tauri.dev.conf.json",
    "tauri:android-init": "bash scripts/android-init.sh",
    "tauri:build": "npm run build:native && tauri build",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "build:e2e": "cd e2e/.app && NUXT_PUBLIC_API_BASE=http://localhost:8081 ../../node_modules/.bin/nuxt build",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:headed": "playwright test --headed",
    "test:coverage": "vitest run --coverage",
    "audit:security": "node scripts/audit-dependencies.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.3",
    "@tauri-apps/plugin-clipboard-manager": "^2.4.2",
    "@tauri-apps/plugin-deep-link": "^2.6.2",
    "@tauri-apps/plugin-opener": "^2.7.1",
    "nuxt": "^4.6.2",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tauri-apps/cli": "^2.12.2",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.0.3",
    "happy-dom": "^21.0.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.12",
    "wrangler": "^4"
  }
}

# production 範本（Linode + Dokploy + Cloudflare Tunnel）。複製成 .env 或貼進 Dokploy 環境變數，不要 commit 真實值。
# 缺任何「必填」項後端會直接拒絕啟動。

# --- 基本 ---
APP_ENV=production
DATABASE_URL=postgres://wishly:CHANGE_ME@localhost:5432/wishly
# 容器內需 0.0.0.0:8080（會印 WARN，預期的；8080 不得對外發布，只讓 cloudflared 可達）
BIND=0.0.0.0:8080
APP_URL=https://wishly.tw
API_BASE_URL=https://api.wishly.tw

# --- 機密：各自獨立、>=32 字元。產生：openssl rand -hex 32 ---
OTP_PEPPER=
OAUTH_SECRET=
UNSUB_SECRET=
# 產生：openssl rand -base64 32。遺失 = 已存地址無法解密，無輪替機制，務必備份兩處
SHIPPING_ENC_KEY=

# --- Cloudflare ---
TRUSTED_PROXY=cloudflare
# 寄信（Cloudflare Email Service）；MAIL_FROM 須為已驗證網域
CF_ACCOUNT_ID=
CF_EMAIL_API_TOKEN=
MAIL_FROM=Wishly <no-reply@wishly.tw>
# CDN 快取清除；Token 只需 Zone -> Cache Purge
CF_ZONE_ID=
CF_CACHE_PURGE_TOKEN=
# 檢舉用 Turnstile
TURNSTILE_SECRET=

# --- 物件儲存（Cloudflare R2，path-style）---
S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_BUCKET=wishly-media
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto
# 綁定 bucket 的自訂網域，不要用 r2.dev；incoming/ 前綴不得公開
S3_PUBLIC_BASE=https://media.wishly.tw

# --- 選填 ---
# Tauri 原生殼才需要；未設只允許 APP_URL
# NATIVE_ORIGINS=tauri://localhost,http://tauri.localhost
# NATIVE_REDIRECT=wishly://auth
# LINE_CHANNEL_ID=
# LINE_CHANNEL_SECRET=
# LINE_REDIRECT_URI=https://api.wishly.tw/api/v1/auth/oauth/line/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=https://api.wishly.tw/api/v1/auth/oauth/google/callback

# 放在 VPS 的 /etc/wishly-backup/r2.env（chmod 600）。金鑰用專屬於備份 bucket 的 R2 token，不可與應用的 S3_* 共用。
# 格式需同時能被 bash source 與 docker --env-file 讀取：KEY=value，不加引號。
R2_BUCKET=wishly-db-backups
RCLONE_CONFIG_R2_TYPE=s3
RCLONE_CONFIG_R2_PROVIDER=Cloudflare
RCLONE_CONFIG_R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
RCLONE_CONFIG_R2_ACCESS_KEY_ID=
RCLONE_CONFIG_R2_SECRET_ACCESS_KEY=
# 可選：healthchecks.io 之類的 ping 網址，沒收到就告警
PING_URL=
